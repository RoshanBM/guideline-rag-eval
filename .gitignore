# Raw source documents (WHO PDFs/EPUB) are not redistributed.
# `data/raw/*` ignores everything in data/raw/ while keeping the folder (.gitkeep)
# and the provenance manifest with SHA-256 hashes (MANIFEST.md).
data/raw/*
!data/raw/.gitkeep
!data/raw/MANIFEST.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
